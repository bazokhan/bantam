{
  "name": "@gamercury/bantam",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:sdk && npm run build:admin-ui",
    "build:server": "tsc -p tsconfig.build.json",
    "build:sdk": "npm run build -w @gamercury/bantam-sdk",
    "build:admin-ui": "npm run build -w @gamercury/bantam-admin-ui",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "format": "prettier --write . && npm run format -w @gamercury/bantam-admin-ui",
    "format:check": "prettier --check . && npm run format:check -w @gamercury/bantam-admin-ui",
    "lint": "eslint . && npm run lint -w @gamercury/bantam-admin-ui",
    "typecheck": "tsc --noEmit && npm run typecheck -w @gamercury/bantam-sdk && npm run typecheck -w @gamercury/bantam-admin-ui",
    "admin-ui:dev": "npm run dev -w @gamercury/bantam-admin-ui",
    "test": "vitest run",
    "test:unit": "vitest run test/bantam.test.ts",
    "test:integration": "vitest run test/bantam.test.ts",
    "smoke:http": "tsx scripts/http-smoke.ts",
    "adapters:smoke": "tsx scripts/adapters-smoke.ts",
    "admin:smoke": "tsx scripts/admin-smoke.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:start": "node dist/main.js",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "litestream:config": "tsx scripts/generate-litestream-config.ts",
    "ops": "tsx src/ops/cli.ts",
    "docs:install": "npm --prefix docs install",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "docs:check": "npm --prefix docs run build",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run openapi:check",
    "sdk:publish:dry": "node scripts/publish-sdk.mjs --dry-run --skip-verify",
    "sdk:publish": "node scripts/publish-sdk.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/formbody": "9.0.1",
    "@fastify/helmet": "13.0.2",
    "@fastify/swagger": "9.6.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.41",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "pino": "9.11.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.7.2",
    "eslint": "9.38.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "5.0.1"
  }
}
