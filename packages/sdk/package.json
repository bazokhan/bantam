{
  "name": "@gamercury/bantam-sdk",
  "version": "0.3.0",
  "description": "Browser TypeScript client for Bantam — leaderboards, feature flags, and economy (BantamClient).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazokhan/bantam.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://bantam.trugraph.io/sdk/",
  "bugs": {
    "url": "https://github.com/bazokhan/bantam/issues"
  },
  "keywords": [
    "bantam",
    "leaderboard",
    "feature-flags",
    "game-economy",
    "iap",
    "game",
    "gamercury"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
