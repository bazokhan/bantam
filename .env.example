BANTAM_CONFIG_FILE=/etc/bantam/games.json
BANTAM_DATA_DIR=/data
BANTAM_ALLOWED_ORIGINS=http://localhost:4321
BANTAM_ADAPTERS_DIR=/bantam/adapters
BANTAM_GAME_DEMO_IDENTITY_SALT=replace-with-at-least-32-random-bytes
BANTAM_GAME_DEMO_SESSION_SECRET=replace-with-at-least-32-random-bytes
BANTAM_GAME_DEMO_CURSOR_SECRET=replace-with-at-least-32-random-bytes
BANTAM_GAME_ECHO_IDENTITY_SALT=replace-with-at-least-32-random-bytes
BANTAM_GAME_ECHO_SESSION_SECRET=replace-with-at-least-32-random-bytes
BANTAM_GAME_ECHO_CURSOR_SECRET=replace-with-at-least-32-random-bytes
BANTAM_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
LITESTREAM_REPLICA_URL=s3://bantam-local/backups
LITESTREAM_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=bantam-demo
AWS_SECRET_ACCESS_KEY=bantam-demo-password
AWS_REGION=us-east-1